# =============================================================================
# KEEDOHUB CREATIVE OS — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in real values. NEVER commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Persistence engine. Production MUST be "postgres". The "json" engine is an
# explicitly isolated development/test fallback only.
DB_ENGINE="postgres"

# PostgreSQL connection string (used when DB_ENGINE=postgres).
# For a Supabase project this is the "Connection string / pooler" URL or the
# direct postgres URL from Database Settings -> Connection string.
DATABASE_URL="postgresql://user:password@host:5432/keedohub"

# -----------------------------------------------------------------------------
# AUTHENTICATION / SESSIONS
# -----------------------------------------------------------------------------
# Session lifetime in days (default: 30).
SESSION_TTL_DAYS="30"

# -----------------------------------------------------------------------------
# AI (server-side only — never exposed to the browser)
# -----------------------------------------------------------------------------
# Gemini API key. Loaded on the server only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# -----------------------------------------------------------------------------
# HOSTING
# -----------------------------------------------------------------------------
# Public URL where the app is hosted. Used for self-referential links,
# OAuth callbacks, and API endpoints.
APP_URL="https://keedohub.example.com"

# HTTP port the Express server listens on (default: 3000).
PORT="3000"

# -----------------------------------------------------------------------------
# ADMIN BOOTSTRAP (first super_admin provisioning)
# -----------------------------------------------------------------------------
# Solves the chicken-and-egg problem: no admin exists to promote the first
# admin. When both values are set, the server idempotently ensures this email
# owns a super_admin role on boot/login. Leave unset to disable.
ADMIN_BOOTSTRAP_EMAIL="ops@keedohub.example.com"
ADMIN_BOOTSTRAP_PASSWORD="change-me-immediately"
ADMIN_BOOTSTRAP_NAME="KeedoHub Operations"
